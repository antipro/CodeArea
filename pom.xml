<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bitifyware</groupId>
    <artifactId>code-area</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <proguard.version>7.6.1</proguard.version>
        <logback.version>1.5.6</logback.version>
        <lombok.version>1.18.36</lombok.version>
        <proguard.maven.plugin.version>2.6.1</proguard.maven.plugin.version>
        <javafx.version>23.0.1</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.openjfx -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>net.raumzeitfalle.fx</groupId>
            <artifactId>scenic-view</artifactId>
            <version>11.0.2</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-media</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-swing</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.hamcrest</groupId>
                    <artifactId>hamcrest-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                        <version>${proguard.maven.plugin.version}</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>proguard</goal>
                                </goals>
                            </execution>
                        </executions>

                        <configuration>
                            <proguardVersion>${proguard.version}</proguardVersion>
                            <injar>${project.build.finalName}.jar</injar>
                            <outjar>${project.build.finalName}.jar</outjar>
                            <obfuscate>true</obfuscate>
                            <options>
                                <!--                                <option>-dontshrink</option>-->
                                <!--                                <option>-dontoptimize</option>-->

                                <!-- Replace class-name strings used in reflection, such as Class.forName("className"), with their new names. -->
                                <!--                                <option>-adaptclassstrings</option>-->

                                <!-- Preserve original annotations and other attributes; otherwise, annotations are removed. -->
                                <!--                                <option>-keepattributes-->
                                <!--                                    Exceptions,-->
                                <!--                                    InnerClasses,-->
                                <!--                                    Signature,-->
                                <!--                                    Deprecated,-->
                                <!--                                    SourceFile,-->
                                <!--                                    LineNumberTable,-->
                                <!--                                    *Annotation*,-->
                                <!--                                    EnclosingMethod-->
                                <!--                                </option>-->

                                <!-- Preserve original interface names without obfuscation. -->
                                <!--                                <option>-keepnames interface **</option>-->

                                <!-- Preserve original method parameter names. -->
                                <!--                                <option>-keepparameternames</option>-->

                                <!-- Preserve original classes without obfuscation, typically in domain or service packages. -->

                                <!-- Ignore warnings, such as duplicate class definitions or classes in incorrectly named files. -->
                                <option>-ignorewarnings</option>
                                <option>-keeppackagenames</option>
                                <option>-keepattributes Signature</option>

                                <!-- Preserve original classes in service packages without obfuscation. -->
                                <!--                                <option>-keep class javafx.** { *; }</option>-->
                                <option>-keep class module-info { *; }</option>
                                <option>-keep class javafx.** { *; }</option>
                                <option>-keep class com.bitifyware.control.utils.* { *; }</option>
                                <option>-keep class com.bitifyware.control.skin.* { *; }</option>
                                <option>-keep class com.bitifyware.control.syntax.* { *; }</option>
                                <option>-keep class com.bitifyware.control.* { *; }</option>
                                <!-- Preserve original interfaces in all packages without obfuscation. -->
                                <option>-keep interface * extends * { *; }</option>

                                <!-- Preserve originally declared annotations in all classes and packages. -->
                                <option>-keep class com.fasterxml.jackson.** { *; }</option>
                                <option>-keep class org.json.JSONObject.** {**
                                    put(java.lang.String,java.util.Map);}</option>

                                <option>-dontwarn com.fasterxml.jackson.databind.**</option>
                                <option>-dontwarn com.fasterxml.jackson.**</option>

                            </options>
                            <injarNotExistsSkip>true</injarNotExistsSkip>
                            <libs>
                                <!-- Add required libraries here. -->
                                <lib>${java.home}/jmods</lib>
                            </libs>

                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>com.guardsquare</groupId>
                                <artifactId>proguard-base</artifactId>
                                <version>${proguard.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <annotationProcessorPath>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </annotationProcessorPath>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>--add-exports</arg>
                        <arg>javafx.base/com.sun.javafx=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.base/com.sun.javafx.collections=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.base/com.sun.javafx.binding=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.graphics/com.sun.javafx.scene.input=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.graphics/com.sun.javafx.tk=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.graphics/com.sun.javafx.scene.text=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.graphics/com.sun.javafx.geom=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.graphics/com.sun.javafx.util=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.graphics/com.sun.javafx.scene=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.graphics/com.sun.javafx.application=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.controls/com.sun.javafx.scene.control=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.controls/com.sun.javafx.scene.control.behavior=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.controls/com.sun.javafx.scene.control.inputmap=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.controls/com.sun.javafx.scene.control.skin.resources=com.bitifyware.codearea</arg>
                        <arg>--add-exports</arg>
                        <arg>javafx.controls/com.sun.javafx.scene.control.skin=com.bitifyware.codearea</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M5</version>
                <configuration>
                    <argLine>
                        -ea
                        --add-exports javafx.base/com.sun.javafx.binding=com.bitifyware.codearea
                        --add-exports javafx.base/com.sun.javafx.binding=ALL-UNNAMED
                        --add-exports javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-exports javafx.graphics/com.sun.javafx.util=com.bitifyware.codearea
                        --add-exports javafx.graphics/com.sun.javafx.application=com.bitifyware.codearea
                        --add-exports javafx.base/com.sun.javafx.collections=ALL-UNNAMED
                        --add-exports javafx.base/com.sun.javafx.collections=com.bitifyware.codearea
                        --add-exports javafx.controls/com.sun.javafx.scene.control.behavior=com.bitifyware.codearea
                        --add-exports javafx.controls/com.sun.javafx.scene.control=com.bitifyware.codearea
                        --add-exports javafx.controls/com.sun.javafx.scene.control.skin.resources=com.bitifyware.codearea
                        --add-exports javafx.controls/com.sun.javafx.scene.control.inputmap=com.bitifyware.codearea
                        --add-exports javafx.controls/com.sun.javafx.scene.control.skin=com.bitifyware.codearea
                        --add-exports javafx.graphics/com.sun.javafx.tk=com.bitifyware.codearea
                        --add-exports javafx.graphics/com.sun.javafx.scene.input=com.bitifyware.codearea
                        --add-exports javafx.graphics/com.sun.javafx.scene.text=com.bitifyware.codearea
                        --add-exports javafx.graphics/com.sun.javafx.geom=com.bitifyware.codearea
                        --add-exports javafx.base/com.sun.javafx=com.bitifyware.codearea
                        --add-exports javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
                        --add-opens javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
                        --add-opens javafx.graphics/com.sun.javafx.tk.quantum=ALL-UNNAMED
                        --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
